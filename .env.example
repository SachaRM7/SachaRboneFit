# Postgres direct (Drizzle). ATTENTION : ce role contourne la RLS Supabase.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase (auth cote client et serveur)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seed de developpement — doit correspondre a un utilisateur Supabase reel
SEED_USER_ID=
SEED_USER_EMAIL=sacha@local

# Protege /api/cron/*
CRON_SECRET=

# Coach IA — OpenCode Zen. Sans cle, l'application fonctionne et le coach repond 503.
# https://opencode.ai/zen
OPENCODE_API_KEY=
# Modele rapide pour le chat, puis repli sur le modele complet.
LLM_CHAINE_COURANTE=opencode:glm-5.3-flash,opencode:glm-5.3
# Modele complet pour les arbitrages et constructions plus exigeants.
LLM_CHAINE_LOURDE=opencode:glm-5.3,opencode:glm-5.3-flash
# Fournisseurs historiques encore compatibles si une chaine les designe explicitement.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
