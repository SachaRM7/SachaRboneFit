# Postgres direct (Drizzle). ATTENTION : ce role contourne la RLS Supabase.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase (auth cote client et serveur)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seed de developpement — doit correspondre a un utilisateur Supabase reel
SEED_USER_ID=
SEED_USER_EMAIL=sacha@local

# Protege /api/cron/*
CRON_SECRET=

# Coach IA (optionnel — voir "Limites connues" dans le README)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
