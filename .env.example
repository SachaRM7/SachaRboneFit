# Postgres direct (Drizzle). ATTENTION : ce role contourne la RLS Supabase.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase (auth cote client et serveur)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seed de developpement — doit correspondre a un utilisateur Supabase reel
SEED_USER_ID=
SEED_USER_EMAIL=sacha@local

# Protege /api/cron/*
CRON_SECRET=

# Coach IA — OpenCode Zen. Sans cle, l'application fonctionne et le coach repond 503.
# https://opencode.ai/zen/go
OPENCODE_API_KEY=
# Modèle Go validé pour le chat.
LLM_CHAINE_COURANTE=opencode:deepseek-v4.1-flash
# Même moteur validé pour les constructions de séance.
LLM_CHAINE_LOURDE=opencode:deepseek-v4.1-flash
# Fournisseurs historiques encore compatibles si une chaine les designe explicitement.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
