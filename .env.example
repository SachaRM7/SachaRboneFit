# Postgres direct (Drizzle). ATTENTION : ce role contourne la RLS Supabase.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase (auth cote client et serveur)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seed de developpement — doit correspondre a un utilisateur Supabase reel
SEED_USER_ID=
SEED_USER_EMAIL=sacha@local

# Protege /api/cron/*
CRON_SECRET=

# Coach IA — optionnel. Sans cle, l'application fonctionne et le coach repond 503.
# Fournisseurs : gemini (defaut, offre gratuite), groq (gratuit), openai, anthropic.
LLM_PROVIDER=gemini
LLM_MODEL=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
